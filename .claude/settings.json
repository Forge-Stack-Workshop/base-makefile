{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompact": true,
  "autoCompactThreshold": 0.85,
  "effortLevel": "medium",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "notify-send 'Claude Code' 'En attente de ton input' 2>/dev/null || true",
            "name": "notify-user-input",
            "timeout": 3000,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node .claude/hooks/verifiable-thresholds.cjs",
            "name": "verifiable-thresholds",
            "timeout": 10000,
            "type": "command"
          }
        ],
        "matcher": "Write|Edit"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "~/.claude/hooks/pre-compact.sh",
            "timeout": 5000,
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node .claude/hooks/secret-scanner.cjs",
            "name": "secret-scanner",
            "timeout": 10000,
            "type": "command"
          },
          {
            "command": "node .claude/hooks/circuit-breaker.cjs",
            "name": "circuit-breaker",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      },
      {
        "hooks": [
          {
            "command": "CMD=$(python3 -c \"import json,sys; d=json.load(sys.stdin); print(d.get('tool_input',d).get('command',''))\" 2>/dev/null || true); case \"$CMD\" in *grep*|*rg\\ *|*ripgrep*|*find\\ *|*fd\\ *|*ack\\ *|*ag\\ *)   [ -f graphify-out/graph.json ] &&   echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"graphify: knowledge graph at graphify-out/. For focused questions, run `graphify query \\\"<question>\\\"` (scoped subgraph, usually much smaller than GRAPH_REPORT.md) instead of grepping raw files. Read GRAPH_REPORT.md only for broad architecture context.\"}}'   || true ;; esac",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node .claude/hooks/frustration-detection.cjs",
            "name": "frustration-detection",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(rtk git status *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git log *)",
      "Bash(rtk git show *)",
      "Bash(rtk git branch *)",
      "Bash(rtk git add *)",
      "Bash(rtk git commit *)",
      "Bash(rtk gh pr view *)",
      "Bash(rtk gh pr list *)",
      "Bash(rtk gh pr diff *)",
      "Bash(rtk gh pr checks *)",
      "Bash(rtk gh issue view *)",
      "Bash(rtk gh issue list *)",
      "Bash(rtk gh run list *)",
      "Bash(rtk gh run view *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Bash(gh repo *)",
      "Bash(rm -rf *)",
      "Bash(rtk git push *)",
      "Bash(rtk gh pr create *)",
      "Bash(rtk gh pr merge *)",
      "Bash(rtk gh release *)",
      "Bash(rtk gh repo *)",
      "Bash(rtk rm -rf *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.vault-token)",
      "Read(!.env.example)"
    ]
  },
  "model": "haiku"
}
