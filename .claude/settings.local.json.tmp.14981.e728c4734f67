{
  "permissions": {
    "allow": [
      "Bash(cp Makefile.with-sub-folder /tmp/t.mk)",
      "Bash(rtk make *)",
      "Bash(echo \"EXIT=$?\")",
      "Bash(git checkout *)",
      "Bash(chmod +x scripts/smoke-test.sh)",
      "Bash(./scripts/smoke-test.sh)",
      "Bash(echo \"RC=$?\")",
      "Bash(rtk git *)",
      "Bash(SKIP=no-commit-to-branch rtk pre-commit run --all-files)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ]
  }
}
